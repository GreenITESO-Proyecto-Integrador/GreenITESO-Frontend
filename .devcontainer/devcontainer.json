{
  // Entorno de desarrollo del FRONTEND de GreenITESO.
  // Stack: TypeScript + React + Vite · pnpm · ESLint · Playwright · Tailwind + shadcn/ui
  "name": "GreenITESO Frontend",

  "build": {
    "dockerfile": "Dockerfile"
  },

  // node_modules vive en un volumen de Docker, no en la carpeta del host.
  // - Funciona igual en Windows, macOS y Linux (NTFS, APFS, ext4, btrfs...).
  // - Mucho mas rapido que un bind mount en Docker Desktop.
  // - No mezcla binarios nativos del host (darwin/win32) con los del contenedor (linux).
  // ${devcontainerId} da un volumen distinto por clon/worktree del repo.
  "mounts": [
    "source=greeniteso-frontend-nm-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],

  // En Windows y macOS los eventos de cambio de archivos del host no siempre
  // llegan al contenedor; vite.config.ts usa polling cuando esta variable existe.
  "containerEnv": {
    "CHOKIDAR_USEPOLLING": "true"
  },

  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Vite PWA (dev)", "onAutoForward": "openBrowser" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "usernamehw.errorlens",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.tabSize": 2,
        "files.eol": "\n",
        // Prettier como formateador predeterminado
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        // ESLint como fixer al guardar (linter elegido por el equipo)
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
        // Autocompletado de clases Tailwind dentro de strings
        "editor.quickSuggestions": {
          "strings": "on"
        },
        // IntelliSense de Tailwind dentro de helpers de shadcn/ui (cva, cn)
        "tailwindCSS.experimental.classRegex": [
          ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
          ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
        ]
      }
    }
  },

  "remoteUser": "node"
}
